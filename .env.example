# Environment Configuration for Waypoint Logistics

# General Application
ENVIRONMENT=development
DEBUG=true

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000

# Backend Service
PORT=5000
BACKEND_PORT=5000
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waypoint_logistics
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waypoint_logistics

# Keycloak Authentication & Authorization
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=waypoint
KEYCLOAK_CLIENT_ID=waypoint-backend
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_AUDIENCE=account
KEYCLOAK_DEV_MODE=true
