# ==============================================================================
# Waypoint Logistics - Root & Docker Compose Configuration Template
# ==============================================================================

# General Application
ENVIRONMENT=development
DEBUG=true

# Frontend Service (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STORE_DATA_SOURCE=api
NEXT_PUBLIC_STORE_OUTLET_ID=1

# Backend Service (FastAPI)
PORT=5000
BACKEND_PORT=5000
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DISPATCHER_DEFAULT_DEPOT=peliyagoda

# PostgreSQL Database Configuration
DB_HOST=database
DB_PORT=5432
DB_NAME=waypoint_logistics
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/waypoint_logistics
DATABASE_URL_UNPOOLED=

# Keycloak Authentication & Authorization
KEYCLOAK_URL=https://auth.tenderease.me
KEYCLOAK_REALM=waypointlogistics
KEYCLOAK_CLIENT_ID=waypoint-backend
KEYCLOAK_FRONTEND_CLIENT_ID=waypoint-frontend
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_ALGORITHM=RS256
KEYCLOAK_AUDIENCE=account
KEYCLOAK_DEV_MODE=true

# Optional: Cloudflare R2 driver photo storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional: Operational email notifications
EMAIL_USER=
EMAIL_APP_PASSWORD=
